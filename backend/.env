# Azure Authentication
AZURE_AUTH_MODE=CLI
# For SERVICE_PRINCIPAL mode, set these:
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# Subscriptions (comma-separated, leave empty for auto-discover from tenant)
AZURE_SUBSCRIPTION_IDS=

# Cache Settings
CACHE_TTL_HOURS=1

# Azure Cost Export (Storage)
AZURE_STORAGE_ACCOUNT_URL=https://turbonomichillrom.blob.core.windows.net
AZURE_STORAGE_CONTAINER=cost-export
AZURE_STORAGE_SAS_TOKEN=sp=rl&st=2026-02-07T07:04:29Z&se=2026-02-28T15:19:29Z&spr=https&sv=2024-11-04&sr=c&sig=DEe9Qm49Ck8LrW46TPylYB%2FJKP45IOHbuDjSl2%2BHm%2Fo%3D
AZURE_COST_EXPORT_PATH=Finops/FinOps/

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8501

# Detection Thresholds
ZOMBIE_DAYS_THRESHOLD=90
SNAPSHOT_AGE_DAYS=365
LOG_ANALYTICS_RETENTION_THRESHOLD=31
