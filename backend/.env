# Azure Authentication
AZURE_AUTH_MODE=CLI
# For SERVICE_PRINCIPAL mode, set these:
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# Subscriptions (comma-separated, leave empty for auto-discover from tenant)
AZURE_SUBSCRIPTION_IDS=4d4ca136-398a-4647-93d2-bcf72e587c3e,5b3f960a-8854-48bd-8c59-1d7320781a0f,af8cff68-2e9e-4464-a71b-e4245d263d2b

# Cache Settings
CACHE_TTL_HOURS=1

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8501

# Detection Thresholds
ZOMBIE_DAYS_THRESHOLD=90
SNAPSHOT_AGE_DAYS=365
LOG_ANALYTICS_RETENTION_THRESHOLD=31
