# ============================================
# NETWORK ACCESS CONFIGURATION
# ============================================

# Backend Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://10.137.3.39:8000

# CORS Settings - Allow access from multiple origins
FRONTEND_URL=http://10.137.3.39:8501
ALLOWED_ORIGINS=http://10.137.3.39:8501,http://localhost:8501,http://127.0.0.1:8501

# ============================================
# AZURE CONFIGURATION
# ============================================

# Azure Authentication
AZURE_AUTH_MODE=CLI
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# Subscriptions (leave empty for auto-discovery)
AZURE_SUBSCRIPTION_IDS=

# Cache Settings
CACHE_TTL_HOURS=1

# Azure Cost Export (Storage) - Optional
# AZURE_STORAGE_ACCOUNT_URL=
# AZURE_STORAGE_CONTAINER=
# AZURE_STORAGE_SAS_TOKEN=
# AZURE_COST_EXPORT_PATH=

# ============================================
# DETECTION THRESHOLDS
# ============================================

ZOMBIE_DAYS_THRESHOLD=90
SNAPSHOT_AGE_DAYS=365
LOG_ANALYTICS_RETENTION_THRESHOLD=31

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
